# NyaySetu environment template
# Copy to .env and fill locally. Never commit real secrets.
# Never expose API keys or JWT secrets in frontend code.

# --- Application ---
APP_NAME=NyaySetu
APP_ENV=development
APP_DEBUG=true

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Comma-separated browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Phase 2+) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Database (PostgreSQL) ---
# SQLAlchemy URL. Example shape only — replace USER, PASSWORD, HOST.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nyaysetu

# Isolated database for pytest (optional). Do not use production.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nyaysetu_test

# --- Authentication ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- LLM (server-side only, later phases) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1024

# --- Retrieval / vector store (later phases) ---
VECTOR_STORE=faiss
VECTOR_INDEX_PATH=knowledge_base/indexes

# --- Privacy / logging ---
LOG_LEVEL=INFO
LOG_QUERY_TEXT=false
