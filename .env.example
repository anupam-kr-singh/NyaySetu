# NyaySetu environment template
# Copy to .env and fill locally. Never commit real secrets.
# Never expose API keys or JWT secrets in frontend code.

# --- Application ---
APP_NAME=NyaySetu
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/nyaysetu

# --- Authentication ---
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_HASH_SCHEME=argon2

# --- LLM (server-side only) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=1024

# --- Retrieval / vector store ---
VECTOR_STORE=faiss
VECTOR_INDEX_PATH=knowledge_base/indexes

# --- Privacy / logging ---
LOG_LEVEL=INFO
LOG_QUERY_TEXT=false
